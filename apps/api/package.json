{
  "name": "@smallverse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/entrypoints/public.js",
  "scripts": {
    "dev": "tsx watch src/entrypoints/public.ts",
    "dev:operator": "tsx watch src/entrypoints/operator.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/entrypoints/public.js",
    "start:operator": "node dist/entrypoints/operator.js",
    "start:worker": "node dist/entrypoints/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@sinclair/typebox": "^0.34.41",
    "@smallverse/contracts": "0.1.0",
    "@smallverse/database": "0.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
