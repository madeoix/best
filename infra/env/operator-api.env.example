NODE_ENV=production
SMALLVERSE_VERSION=replace-with-git-commit
SMALLVERSE_LOG_LEVEL=info
SMALLVERSE_OPERATOR_HOST=100.118.39.6
SMALLVERSE_OPERATOR_PORT=8781
SMALLVERSE_OPERATOR_SCOPES=services:read,services:write,operations:read,operations:write,sessions:write,audit:read
SMALLVERSE_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
SMALLVERSE_OPERATOR_SERVICES=smallverse-explorer.service,smallverse-admin.service
SMALLVERSE_SYSTEMCTL_COMMAND=/usr/bin/sudo,-n,/usr/bin/systemctl
SMALLVERSE_PRIVILEGED_COMMAND=/usr/bin/sudo,-n
SMALLVERSE_ROOT=/opt/smallverse
SMALLVERSE_REMOTE_SESSION_ROOT=/opt/smallverse/probe-lab-connect
SMALLVERSE_WORKSPACE=/opt/smallverse/workspace
SMALLVERSE_AUTOMATION_ROOT=/opt/smallverse/automation-workspace
SMALLVERSE_PUBLIC_DIR=/var/www/smallverse
SMALLVERSE_OPERATOR_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://smallverse_operator:replace-me@127.0.0.1:5432/smallverse
