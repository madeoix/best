		</frame>

		<frame id="LeftSwing3" name="Left Swing 3">
			<sectionref id="LeftLegWalk3"/>
			<sectionref id="RightLegIdle"/>
			<sectionref id="Shadow"/>
		</frame>


		<frame id="LeftSwing4" name="Left Swing 4">
			<sectionref id="LeftLegWalk4"/>
			<sectionref id="RightLegIdle"/>
			<sectionref id="Shadow"/>
		</frame>


		<frame id="RightSwing1" name="Right Swing 1">
			<sectionref id="LeftLegIdle"/>
			<sectionref id="RightLegWalk1"/>
			<sectionref id="Shadow"/>
		</frame>

		<frame id="RightSwing2" name="Right Swing 2">
			<sectionref id="LeftLegIdle"/>
			<sectionref id="RightLegWalk2"/>
			<sectionref id="Shadow"/>
		</frame>

		<frame id="RightSwing3" name="Right Swing 3">
			<sectionref id="LeftLegIdle"/>
