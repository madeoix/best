{
  "name": "smallverse-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "avatar:import-renders": "/tmp/sv-amf-venv/bin/python tools/import_avatar_snapshot_captures.py",
    "avatar:watch-renders": "/tmp/sv-amf-venv/bin/python tools/watch_avatar_render_captures.py",
    "dev:web": "vite dev",
    "dev:api": "npm run dev -w @smallverse/api",
    "dev:operator": "npm run dev:operator -w @smallverse/api",
    "dev:worker": "npm run dev:worker -w @smallverse/api",
    "dev:runtime": "node scripts/dev-runtime.mjs",
    "dev:all": "node scripts/dev-runtime.mjs --web",
    "infra:up": "node scripts/dev-infra.mjs up",
    "infra:down": "node scripts/dev-infra.mjs down",
    "infra:logs": "node scripts/dev-infra.mjs logs",
    "sync:exports": "bash scripts/sync-preserved-exports.sh",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "build:web": "vite build",
    "build:contracts": "npm run build -w @smallverse/contracts",
    "build:database": "npm run build -w @smallverse/database",
    "build:api": "npm run build:contracts && npm run build:database && npm run build -w @smallverse/api",
    "build:all": "npm run build:web && npm run build:api",
    "test:api": "npm run build:contracts && npm run build:database && npm run test -w @smallverse/api",
    "test": "npm run check:boundaries && npm run test:api && node --test tests/*.test.mjs",
    "check:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "db:migrate": "npm run migrate -w @smallverse/database",
    "release:package": "npm run build:all && node scripts/package-release.mjs",
    "db:verify": "node scripts/run-db-verify.mjs",
    "tauri": "tauri",
    "test:desktop": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:desktop": "tauri build",
    "production:audit": "node scripts/production-audit.mjs",
    "production:evaluate": "node scripts/evaluate-production-audit.mjs",
    "production:smoke": "node scripts/smoke-production.mjs",
    "release:verify": "node scripts/verify-production-release.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/svelte": "^1.1.4",
    "@internationalized/date": "^3.12.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.4.0",
    "svelte": "^5.56.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@lucide/svelte": "^1.23.0",
    "framer-motion": "^12.42.2",
    "three": "^0.185.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  }
}
